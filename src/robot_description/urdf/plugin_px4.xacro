<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- PLUGINS GAZEBO (Ignition Fortress / gz-sim 6)                -->
  <!-- NOTE : ros2_control a été retiré car PX4 pilote désormais    -->
  <!-- les moteurs. Plus besoin de ign_ros2_control ni de           -->
  <!-- OdometryPublisher (PX4 fournit l'odométrie).                 -->
  <!-- ============================================================ -->

  <gazebo>
    <!-- Système de capteurs (caméra) -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Système IMU Gazebo (sera remplacé par l'IMU de PX4 en SITL) -->
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>
  </gazebo>

  <!-- === Capteur caméra === -->
  <gazebo reference="camera_optical_frame">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
    </sensor>
  </gazebo>

  <!-- === Capteur IMU (Gazebo) === -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
    </sensor>
  </gazebo>

</robot>