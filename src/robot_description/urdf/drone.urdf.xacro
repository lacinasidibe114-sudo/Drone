<?xml version="1.0"?>
<robot name="air3s_style_quadrotor" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Inclus les plugins Gazebo définis séparément -->
  <xacro:include filename="plugin.xacro"/>

  <!-- ================= Materials ================= -->
  <material name="BodyGray"><color rgba="0.580 0.590 0.600 1.0"/></material>
  <material name="ShellGray"><color rgba="0.660 0.670 0.680 1.0"/></material>
  <material name="MotorDark"><color rgba="0.150 0.150 0.160 1.0"/></material>
  <material name="PropDark"><color rgba="0.120 0.120 0.130 1.0"/></material>
  <material name="OrangeTip"><color rgba="1.000 0.380 0.020 1.0"/></material>
  <material name="GimbalBlack"><color rgba="0.090 0.090 0.090 1.0"/></material>
  <material name="LensGlass"><color rgba="0.030 0.030 0.050 1.0"/></material>

  <!-- ================= Fuselage ================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.400"/>
      <inertia
        ixx="0.000420" ixy="0.0" ixz="0.0"
        iyy="0.001324" iyz="0.0"
        izz="0.001502"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.190 0.095 0.060"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="-0.010 0 0.040" rpy="0 0 0"/>
      <geometry><box size="0.150 0.080 0.022"/></geometry>
      <material name="ShellGray"/>
    </visual>
    <visual>
      <origin xyz="0.090 0 -0.004" rpy="0 0 0"/>
      <geometry><box size="0.040 0.088 0.050"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="-0.092 0 -0.002" rpy="0 0 0"/>
      <geometry><box size="0.030 0.080 0.045"/></geometry>
      <material name="BodyGray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.190 0.095 0.060"/></geometry>
    </collision>
  </link>

  <!-- ================= Bras + moteurs ================= -->

  <!-- Bras avant gauche -->
  <link name="arm_fl_link">
    <inertial>
      <origin xyz="0.119 0 0" rpy="0 0 0"/>
      <mass value="0.052"/>
      <inertia
        ixx="0.0000054" ixy="0.0" ixz="0.0"
        iyy="0.0001578" iyz="0.0"
        izz="0.0001587"/>
    </inertial>
    <visual>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0.016" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.004"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <collision>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
    </collision>
  </link>

  <joint name="arm_fl_joint" type="fixed">
    <origin xyz="0.055 0.040 0.005" rpy="0 0 0.6109"/>
    <parent link="base_link"/>
    <child link="arm_fl_link"/>
  </joint>

  <!-- Bras avant droit -->
  <link name="arm_fr_link">
    <inertial>
      <origin xyz="0.119 0 0" rpy="0 0 0"/>
      <mass value="0.052"/>
      <inertia
        ixx="0.0000054" ixy="0.0" ixz="0.0"
        iyy="0.0001578" iyz="0.0"
        izz="0.0001587"/>
    </inertial>
    <visual>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0.016" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.004"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <collision>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
    </collision>
  </link>

  <joint name="arm_fr_joint" type="fixed">
    <origin xyz="0.055 -0.040 0.005" rpy="0 0 -0.6109"/>
    <parent link="base_link"/>
    <child link="arm_fr_link"/>
  </joint>

  <!-- Bras arrière gauche -->
  <link name="arm_rl_link">
    <inertial>
      <origin xyz="0.119 0 0" rpy="0 0 0"/>
      <mass value="0.052"/>
      <inertia
        ixx="0.0000054" ixy="0.0" ixz="0.0"
        iyy="0.0001578" iyz="0.0"
        izz="0.0001587"/>
    </inertial>
    <visual>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0.016" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.004"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <collision>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
    </collision>
  </link>

  <joint name="arm_rl_joint" type="fixed">
    <origin xyz="-0.055 0.040 0.000" rpy="0 0.20 2.5307"/>
    <parent link="base_link"/>
    <child link="arm_rl_link"/>
  </joint>

  <!-- Bras arrière droit -->
  <link name="arm_rr_link">
    <inertial>
      <origin xyz="0.119 0 0" rpy="0 0 0"/>
      <mass value="0.052"/>
      <inertia
        ixx="0.0000054" ixy="0.0" ixz="0.0"
        iyy="0.0001578" iyz="0.0"
        izz="0.0001587"/>
    </inertial>
    <visual>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <visual>
      <origin xyz="0.165 0 0.016" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.004"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <collision>
      <origin xyz="0.085 0 0" rpy="0 0 0"/>
      <geometry><box size="0.170 0.022 0.018"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.165 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.019" length="0.028"/></geometry>
    </collision>
  </link>

  <joint name="arm_rr_joint" type="fixed">
    <origin xyz="-0.055 -0.040 0.000" rpy="0 0.20 -2.5307"/>
    <parent link="base_link"/>
    <child link="arm_rr_link"/>
  </joint>

  <!-- ================= Hélices ================= -->

  <!-- Hélice avant gauche -->
  <link name="prop_fl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.009"/>
      <inertia
        ixx="0.0000040" ixy="0.0" ixz="0.0"
        iyy="0.0000430" iyz="0.0"
        izz="0.0000430"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.012"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.058 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.112 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <visual>
      <origin xyz="-0.058 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="-0.112 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.120" length="0.004"/></geometry>
    </collision>
  </link>

  <joint name="prop_fl_joint" type="continuous">
    <origin xyz="0.165 0 0.024" rpy="0 0 0"/>
    <parent link="arm_fl_link"/>
    <child link="prop_fl_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0006" friction="0.0002"/>
  </joint>

  <!-- Hélice avant droite -->
  <link name="prop_fr_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.009"/>
      <inertia
        ixx="0.0000040" ixy="0.0" ixz="0.0"
        iyy="0.0000430" iyz="0.0"
        izz="0.0000430"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.012"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.058 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.112 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <visual>
      <origin xyz="-0.058 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="-0.112 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.120" length="0.004"/></geometry>
    </collision>
  </link>

  <joint name="prop_fr_joint" type="continuous">
    <origin xyz="0.165 0 0.024" rpy="0 0 0"/>
    <parent link="arm_fr_link"/>
    <child link="prop_fr_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0006" friction="0.0002"/>
  </joint>

  <!-- Hélice arrière gauche -->
  <link name="prop_rl_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.009"/>
      <inertia
        ixx="0.0000040" ixy="0.0" ixz="0.0"
        iyy="0.0000430" iyz="0.0"
        izz="0.0000430"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.012"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.058 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.112 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <visual>
      <origin xyz="-0.058 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="-0.112 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.120" length="0.004"/></geometry>
    </collision>
  </link>

  <joint name="prop_rl_joint" type="continuous">
    <origin xyz="0.165 0 0.024" rpy="0 0 0"/>
    <parent link="arm_rl_link"/>
    <child link="prop_rl_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0006" friction="0.0002"/>
  </joint>

  <!-- Hélice arrière droite -->
  <link name="prop_rr_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.009"/>
      <inertia
        ixx="0.0000040" ixy="0.0" ixz="0.0"
        iyy="0.0000430" iyz="0.0"
        izz="0.0000430"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.008" length="0.012"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.058 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="0.112 0 0" rpy="0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <visual>
      <origin xyz="-0.058 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.105 0.019 0.0018"/></geometry>
      <material name="PropDark"/>
    </visual>
    <visual>
      <origin xyz="-0.112 0 0" rpy="-0.35 0 0"/>
      <geometry><box size="0.012 0.017 0.0020"/></geometry>
      <material name="OrangeTip"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.120" length="0.004"/></geometry>
    </collision>
  </link>

  <joint name="prop_rr_joint" type="continuous">
    <origin xyz="0.165 0 0.024" rpy="0 0 0"/>
    <parent link="arm_rr_link"/>
    <child link="prop_rr_link"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0006" friction="0.0002"/>
  </joint>

  <!-- ================= Pattes d'atterrissage ================= -->

  <link name="leg_l_link">
    <inertial>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia
        ixx="0.0000058" ixy="0.0" ixz="0.0"
        iyy="0.0000058" iyz="0.0"
        izz="0.00000029"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry><cylinder radius="0.007" length="0.075"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry><cylinder radius="0.007" length="0.075"/></geometry>
    </collision>
  </link>

  <joint name="leg_l_joint" type="fixed">
    <origin xyz="0.190 0.135 -0.005" rpy="0.30 0 0"/>
    <parent link="base_link"/>
    <child link="leg_l_link"/>
  </joint>

  <link name="leg_r_link">
    <inertial>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia
        ixx="0.0000058" ixy="0.0" ixz="0.0"
        iyy="0.0000058" iyz="0.0"
        izz="0.00000029"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry><cylinder radius="0.007" length="0.075"/></geometry>
      <material name="BodyGray"/>
    </visual>
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry><sphere radius="0.009"/></geometry>
      <material name="MotorDark"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.0375" rpy="0 0 0"/>
      <geometry><cylinder radius="0.007" length="0.075"/></geometry>
    </collision>
  </link>

  <joint name="leg_r_joint" type="fixed">
    <origin xyz="0.190 -0.135 -0.005" rpy="-0.30 0 0"/>
    <parent link="base_link"/>
    <child link="leg_r_link"/>
  </joint>

  <!-- ================= Nacelle caméra 2 axes ================= -->

  <link name="gimbal_yaw_link">
    <inertial>
      <origin xyz="0 0 -0.009" rpy="0 0 0"/>
      <mass value="0.020"/>
      <inertia
        ixx="0.0000022" ixy="0.0" ixz="0.0"
        iyy="0.0000022" iyz="0.0"
        izz="0.0000030"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.009" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.018"/></geometry>
      <material name="GimbalBlack"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.009" rpy="0 0 0"/>
      <geometry><box size="0.030 0.030 0.018"/></geometry>
    </collision>
  </link>

  <joint name="gimbal_yaw_joint" type="revolute">
    <origin xyz="0.098 0 -0.015" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="gimbal_yaw_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="0.52" effort="1.0" velocity="2.0"/>
    <dynamics damping="0.005" friction="0.001"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.045"/>
      <inertia
        ixx="0.0000170" ixy="0.0" ixz="0.0"
        iyy="0.0000139" iyz="0.0"
        izz="0.0000122"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.042 0.052"/></geometry>
      <material name="GimbalBlack"/>
    </visual>
    <visual>
      <origin xyz="0.018 0 0.012" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.009" length="0.010"/></geometry>
      <material name="LensGlass"/>
    </visual>
    <visual>
      <origin xyz="0.018 0 -0.010" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.011" length="0.010"/></geometry>
      <material name="LensGlass"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.042 0.052"/></geometry>
    </collision>
  </link>

  <joint name="gimbal_pitch_joint" type="revolute">
    <origin xyz="0.005 0 -0.028" rpy="0 0 0"/>
    <parent link="gimbal_yaw_link"/>
    <child link="camera_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="0.6109" effort="1.0" velocity="2.0"/>
    <dynamics damping="0.005" friction="0.001"/>
  </joint>

  <link name="camera_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia
        ixx="0.00000010" ixy="0.0" ixz="0.0"
        iyy="0.00000010" iyz="0.0"
        izz="0.00000010"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0.026 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>

  <!-- ================= IMU ================= -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia
        ixx="0.00000036" ixy="0.0" ixz="0.0"
        iyy="0.00000036" iyz="0.0"
        izz="0.00000067"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.020 0.020 0.005"/></geometry>
      <material name="GimbalBlack"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

</robot>